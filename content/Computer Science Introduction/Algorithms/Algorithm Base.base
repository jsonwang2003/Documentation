filters:
  and:
    - file.folder.contains("Computer Science/Algorithms")
formulas:
  Untitled: ""
properties:
  file.basename:
    displayName: File
views:
  - type: table
    name: Table
    order:
      - file.basename
      - description
      - tags
    sort:
      - property: file.name
        direction: ASC
  - type: cards
    name: View
    order:
      - file.name
      - aliases
      - description
      - tags
    cardSize: 200
    imageAspectRatio: 0.9
    image: file.file
